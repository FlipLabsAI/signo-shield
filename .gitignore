# Foundry build output. `abi/` is CHECKED IN on purpose — see tools/export-artifacts.sh:
# the submission needs ABIs a judge can read without running the toolchain.
out/
cache/
broadcast/*/dry-run/

# lib/ is NOT ignored: forge-std is a pinned git submodule so a clean
# `git clone --recursive` builds with no network fetch beyond the clone.
docs/book/

.env
.env.*
!.env.example

.DS_Store
node_modules/
