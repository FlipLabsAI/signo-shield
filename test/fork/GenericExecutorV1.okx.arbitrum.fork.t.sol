pragma solidity 0.8.28;

/// A swap through the REAL OKX DEX aggregator router on Arbitrum One from the
/// v1 sandbox, against the Arbitrum deployment's own configuration (DeployV1:
/// the catalog, the WETH and USDC price rounds). The calldata is produced by
/// tools/okx-fixture.py --chain 42161, quoted for the sandbox address this
/// test's deploy order yields (printed by `test_printSandboxAddress`), at the
/// block pinned below. Router and spender as OKX's API names them for 42161
/// (approve-transaction → dexContractAddress), checked 30 Sep 2026.
import {IShieldRegistryV1} from "contracts/v1/interfaces/IShieldRegistryV1.sol";
import {PinnedPrices} from "test/v1/mocks/PinnedPrices.sol";
import {Test, console2} from "forge-std/Test.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {IShieldV1} from "contracts/v1/interfaces/IShieldV1.sol";
import {IExecutorV1} from "contracts/v1/interfaces/IExecutorV1.sol";
import {GenericExecutorV1} from "contracts/v1/GenericExecutorV1.sol";
import {DeployV1} from "script/DeployV1.s.sol";

contract GenericExecutorV1OkxArbitrumForkTest is Test {
    address internal constant WETH = 0x82aF49447D8a07e3bd95BD0d56f35241523fBab1;
    address internal constant A_WETH = 0xe50fA9b3c56FfB159cB0FCA61F5c9D750e8128c8;
    address internal constant USDC = 0xaf88d065e77c8cC2239327C5EDb3A432268e5831;
    address internal constant ORACLE = 0xb56c2F0B653B2e0b10C9b928C8580Ac5Df02C7C7;
    address internal constant OKX_ROUTER = 0x09f94b5Fc68e227C323A6FbaE3Bd98C97fD8c849;
    address internal constant OKX_SPENDER = 0x70cBb871E8f30Fc8Ce23609E9E0Ea87B6b222F58;
    bytes32 internal constant TRANSFORM = keccak256("generic.transform");

    // From tools/okx-fixture.py --chain 42161, quoted for FIXTURE_SANDBOX at FORK_BLOCK.
    uint256 internal constant FORK_BLOCK = 510435842;
    address internal constant FIXTURE_SANDBOX = 0x92a43cB4b06cba34e8eFc39239BE1D7B8c7F2a6f;
    uint256 internal constant AMOUNT_IN = 0.0079e18;
    bytes internal constant OKX_CALLDATA =
        hex"";

    DeployV1.Deployed internal d;
    address internal principal = makeAddr("principal");
    address internal agent = makeAddr("agent");

    function setUp() public {
        string memory rpc = vm.envOr("ARBITRUM_RPC_URL", string("https://arbitrum-one.public.blastapi.io"));
        vm.createSelectFork(rpc, FORK_BLOCK);
        d = new DeployV1().deployWith(makeAddr("owner"), makeAddr("owner"), address(0), 0);
        vm.prank(A_WETH);
        IERC20(WETH).transfer(principal, 1e18);
        vm.prank(principal);
        IERC20(WETH).approve(address(d.shield), type(uint256).max);
    }

    function _register() internal returns (bytes32 id) {
        GenericExecutorV1.Config memory c;
        c.venues = new GenericExecutorV1.Venue[](1);
        c.venues[0] = GenericExecutorV1.Venue({target: OKX_ROUTER, spender: OKX_SPENDER});
        c.sweepSet = new address[](0);
        c.tokenOut = USDC;
        c.rateKind = uint8(GenericExecutorV1.RateKind.Oracle);
        c.oracle = ORACLE;
        c.maxSlippageBps = 100;
        // The deployment's own rounds: WETH on ETH/USD, USDC on the feed under Aave's cap.
        c.prices = PinnedPrices.pin(IShieldRegistryV1(address(d.registry)), WETH, USDC);
        IShieldV1.MandateParams memory p;
        p.agent = agent;
        p.executor = address(d.generic);
        p.evaluator = address(d.evaluator);
        p.action = TRANSFORM;
        p.asset = WETH;
        p.maxTransactionValue = 0.01e18;
        p.maxCumulativeValue = 0.02e18;
        p.validFrom = 0;
        p.validUntil = uint48(block.timestamp + 30 days);
        p.funding = uint8(IShieldV1.FundingMode.PULL);
        p.actionConfig = abi.encode(uint8(1), c);
        vm.prank(principal);
        id = d.shield.registerMandate(p);
    }

    /// Run first to learn the sandbox address the fixture must be quoted for.
    function test_printSandboxAddress() public {
        bytes32 id = _register();
        console2.log("sandbox for the OKX fixture:", d.generic.nextClone(id));
        console2.log("block:", block.number);
    }

    function test_swapThroughTheRealOkxRouterFromTheSandbox() public {
        if (OKX_CALLDATA.length == 0) return; // fixture not yet generated
        bytes32 id = _register();
        address clone = d.generic.nextClone(id);
        assertEq(clone, FIXTURE_SANDBOX, "sandbox address drifted; regenerate the OKX fixture");
        (bytes32 wethRound,) = d.registry.priceRound(WETH);
        (bytes32 usdcRound,) = d.registry.priceRound(USDC);
        assertTrue(wethRound != bytes32(0) && usdcRound != bytes32(0), "the deployment binds both rounds");
        IExecutorV1.Call memory k = IExecutorV1.Call({
            target: OKX_ROUTER,
            spender: OKX_SPENDER,
            approveToken: WETH,
            approveAmount: AMOUNT_IN,
            claimStep: false,
            data: OKX_CALLDATA
        });
        IExecutorV1.Call[] memory calls = new IExecutorV1.Call[](1);
        calls[0] = k;
        bytes memory route = abi.encode(calls);
        uint256 uBefore = IERC20(USDC).balanceOf(principal);
        uint256 wBefore = IERC20(WETH).balanceOf(principal);
        vm.prank(agent);
        uint256 spent = d.shield.fire(id, AMOUNT_IN, route);
        assertEq(spent, AMOUNT_IN, "the whole slice was sold");
        assertEq(wBefore - IERC20(WETH).balanceOf(principal), AMOUNT_IN);
        assertGt(IERC20(USDC).balanceOf(principal) - uBefore, 0, "USDC arrived on the owner");
        assertEq(IERC20(WETH).balanceOf(clone), 0);
        assertEq(IERC20(USDC).balanceOf(clone), 0);
        assertEq(IERC20(WETH).allowance(clone, OKX_SPENDER), 0, "no approval survives");
    }
}
